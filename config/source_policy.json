{
  "schema_version": 1,
  "assembly_root": "src",
  "entrypoint": "src/main.s",
  "layout": "config/rom_layout.json",
  "style": {
    "maximum_line_length": 200,
    "definitions_column_zero": true,
    "includes_only_in_entrypoint": true,
    "lowercase_source_paths": true,
    "require_final_newline": true
  },
  "provenance": {
    "marker": "; was:",
    "minimum_unique_mappings": 4828,
    "legacy_name_pattern": "^(?:[A-Za-z_][A-Za-z0-9_]*_[0-9A-F]+(?:_End)?|JumpTable[12]|PCMPart[1-9]|LoadPalette|CheckFlagsLoadObjData|LoadCompressedTiles|LoadCompressedMappings)$",
    "default_evidence": "hypothesis",
    "note": "Earlier semantic names were generated automatically. A marker maps the most recent definition to its unique imported name, even when the marker is printed on the first instruction."
  },
  "unknowns": {
    "address_derived_name_pattern": "^(?:(?:loc|locret|nullsub|off|unk|unknown|byte|word|dword|flt|stru|asc)_[0-9A-F]+(?:_End)?|[A-Za-z_][A-Za-z0-9_]*_[0-9A-F]{4,}(?:_End)?)$",
    "maximum_address_derived_definitions": 0,
    "note": "This is a burn-down ceiling, not a quality target. New address-derived definitions fail lint; evidence-backed renames reduce the count."
  },
  "naming": {
    "note": "Every definition in assembly source must name a declared subsystem, derive from a symbol that exists, or be a declared hardware exception. The vocabulary was adopted from the reviewed state of the source at Source Reconstruction 1.0 and is closed: a new owner token fails lint until it is added here deliberately.",
